<Window x:Class="SportsStoreApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - Спортивный магазин"
        Height="750" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI">

	<Grid Margin="25">
		<Border Background="White"
                CornerRadius="15"
                Padding="30"
                VerticalAlignment="Center">

			<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="650">
				<StackPanel>
					<!-- Заголовок -->
					<TextBlock Text="ДОБРО ПОЖАЛОВАТЬ"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#1E3C72"
                               Margin="0,0,0,5"/>

					<TextBlock Text="Спортивный магазин"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Foreground="#666"
                               Margin="0,0,0,25"/>

					<!-- Логотип -->
					<StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
						<Ellipse Width="100" Height="100" Stroke="#1E3C72" StrokeThickness="3">
							<Ellipse.Fill>
								<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
									<GradientStop Color="#FF4CAF50" Offset="0"/>
									<GradientStop Color="#FF2E7D32" Offset="1"/>
								</LinearGradientBrush>
							</Ellipse.Fill>
						</Ellipse>
					</StackPanel>

					<!-- Вкладки: Вход / Регистрация -->
					<Grid Margin="0,0,0,25">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Button x:Name="btnLoginTab"
                                Grid.Column="0"
                                Content="ВХОД"
                                Height="45"
                                Background="#1E3C72"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="15"
                                Click="btnLoginTab_Click"/>

						<Button x:Name="btnRegisterTab"
                                Grid.Column="1"
                                Content="РЕГИСТРАЦИЯ"
                                Height="45"
                                Background="#F5F5F5"
                                Foreground="#333"
                                BorderThickness="0"
                                FontWeight="Bold"
                                FontSize="15"
                                Click="btnRegisterTab_Click"/>
					</Grid>

					<!-- Панель ВХОДА -->
					<StackPanel x:Name="panelLogin" Visibility="Visible">
						<!-- Email -->
						<StackPanel Margin="0,0,0,18">
							<TextBlock Text="Email:"
                                       FontWeight="SemiBold"
                                       Foreground="#333"
                                       Margin="0,0,0,6"
                                       FontSize="14"/>
							<TextBox x:Name="txtLoginEmail"
                                     Height="45"
                                     FontSize="15"
                                     Padding="12,0"
                                     BorderBrush="#DDD"
                                     BorderThickness="1"/>
						</StackPanel>

						<!-- Пароль -->
						<StackPanel Margin="0,0,0,25">
							<TextBlock Text="Пароль:"
                                       FontWeight="SemiBold"
                                       Foreground="#333"
                                       Margin="0,0,0,6"
                                       FontSize="14"/>
							<PasswordBox x:Name="txtLoginPassword"
                                         Height="45"
                                         FontSize="15"
                                         Padding="12,0"
                                         BorderBrush="#DDD"
                                         BorderThickness="1"/>
						</StackPanel>

						<!-- Кнопка входа -->
						<Button x:Name="btnLogin"
                                Content="ВОЙТИ"
                                Height="50"
                                FontSize="17"
                                FontWeight="Bold"
                                Background="#4CAF50"
                                Foreground="White"
                                BorderThickness="0"
                                Click="btnLogin_Click"
                                Margin="0,5,0,15"
                                Cursor="Hand"/>
					</StackPanel>

					<!-- Панель РЕГИСТРАЦИИ -->
					<StackPanel x:Name="panelRegister" Visibility="Collapsed">
						<!-- Имя -->
						<StackPanel Margin="0,0,0,18">
							<TextBlock Text="Имя:"
                                       FontWeight="SemiBold"
                                       Foreground="#333"
                                       Margin="0,0,0,6"
                                       FontSize="14"/>
							<TextBox x:Name="txtFirstName"
                                     Height="45"
                                     FontSize="15"
                                     Padding="12,0"
                                     BorderBrush="#DDD"
                                     BorderThickness="1"/>
						</StackPanel>

						<!-- Фамилия -->
						<StackPanel Margin="0,0,0,18">
							<TextBlock Text="Фамилия:"
                                       FontWeight="SemiBold"
                                       Foreground="#333"
                                       Margin="0,0,0,6"
                                       FontSize="14"/>
							<TextBox x:Name="txtLastName"
                                     Height="45"
                                     FontSize="15"
                                     Padding="12,0"
                                     BorderBrush="#DDD"
                                     BorderThickness="1"/>
						</StackPanel>

						<!-- Email -->
						<StackPanel Margin="0,0,0,18">
							<TextBlock Text="Email:"
                                       FontWeight="SemiBold"
                                       Foreground="#333"
                                       Margin="0,0,0,6"
                                       FontSize="14"/>
							<TextBox x:Name="txtRegisterEmail"
                                     Height="45"
                                     FontSize="15"
                                     Padding="12,0"
                                     BorderBrush="#DDD"
                                     BorderThickness="1"/>
						</StackPanel>

						<!-- Пароль -->
						<StackPanel Margin="0,0,0,18">
							<TextBlock Text="Пароль:"
                                       FontWeight="SemiBold"
                                       Foreground="#333"
                                       Margin="0,0,0,6"
                                       FontSize="14"/>
							<PasswordBox x:Name="txtRegisterPassword"
                                         Height="45"
                                         FontSize="15"
                                         Padding="12,0"
                                         BorderBrush="#DDD"
                                         BorderThickness="1"/>
						</StackPanel>

						<!-- Подтверждение пароля -->
						<StackPanel Margin="0,0,0,25">
							<TextBlock Text="Подтвердите пароль:"
                                       FontWeight="SemiBold"
                                       Foreground="#333"
                                       Margin="0,0,0,6"
                                       FontSize="14"/>
							<PasswordBox x:Name="txtConfirmPassword"
                                         Height="45"
                                         FontSize="15"
                                         Padding="12,0"
                                         BorderBrush="#DDD"
                                         BorderThickness="1"/>
						</StackPanel>

						<!-- Кнопка регистрации -->
						<Button x:Name="btnRegister"
                                Content="ЗАРЕГИСТРИРОВАТЬСЯ"
                                Height="50"
                                FontSize="16"
                                FontWeight="Bold"
                                Background="#2196F3"
                                Foreground="White"
                                BorderThickness="0"
                                Click="btnRegister_Click"
                                Margin="0,5,0,15"
                                Cursor="Hand"/>
					</StackPanel>

					<!-- Блок для отображения ошибок -->
					<Border x:Name="errorBorder"
                            Background="#FFEBEE"
                            CornerRadius="8"
                            Padding="12"
                            Visibility="Collapsed"
                            BorderBrush="#FFCDD2"
                            BorderThickness="1"
                            Margin="0,10,0,15">
						<TextBlock x:Name="txtError"
                                   Text=""
                                   Foreground="#D32F2F"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   FontWeight="Medium"/>
					</Border>

					<!-- Информация для тестирования -->
					<Border Background="#E3F2FD"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,10,0,5">
						<StackPanel>
							<TextBlock Text="📋 Тестовые данные:"
                                       FontWeight="Bold"
                                       Foreground="#1976D2"
                                       FontSize="14"
                                       Margin="0,0,0,8"/>
							<TextBlock Text="admin@mail.ru / admin"
                                       Foreground="#1976D2"
                                       FontSize="13"
                                       Margin="0,2,0,2"/>
							<TextBlock Text="user@mail.ru / user"
                                       Foreground="#1976D2"
                                       FontSize="13"
                                       Margin="0,2,0,2"/>
						</StackPanel>
					</Border>

					<!-- Дополнительный отступ снизу -->
					<Rectangle Height="10" Opacity="0"/>
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Grid>
</Window>