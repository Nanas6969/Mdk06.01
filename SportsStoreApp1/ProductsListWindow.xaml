<Window x:Class="SportsStoreApp1.ProductsListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Спортивный магазин - Управление товарами" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="Transparent">

    <Grid Margin="20">
        <Border Background="White" 
                CornerRadius="10" 
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок и информация о пользователе -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Логотип -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse Width="50" Height="50" Stroke="#1E3C72" StrokeThickness="2">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF4CAF50" Offset="0"/>
                                    <GradientStop Color="#FF2E7D32" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="SPORTS STORE" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Foreground="#1E3C72"/>
                    </StackPanel>

                    <!-- Информация о пользователе -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock x:Name="txtUserInfo" 
                                   Text="Пользователь" 
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="#666"
                                   Margin="0,0,10,0"/>
                        <Button x:Name="btnLogout" 
                                Content="Выйти" 
                                Height="35"
                                Width="100"
                                Background="#f44336"
                                Foreground="White"
                                BorderThickness="0"
                                Click="btnLogout_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Панель инструментов -->
                <Border Grid.Row="1" 
                        Background="#F5F5F5" 
                        CornerRadius="5" 
                        Padding="15"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Кнопки действий -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="btnAdd" 
                                    Content="➕ Добавить товар" 
                                    Height="40"
                                    Width="130"
                                    Margin="0,0,10,0"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="btnAdd_Click"/>

                            <Button x:Name="btnEdit" 
                                    Content="✏️ Редактировать" 
                                    Height="40"
                                    Width="130"
                                    Margin="0,0,10,0"
                                    Background="#2196F3"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="btnEdit_Click"/>

                            <Button x:Name="btnDelete" 
                                    Content="🗑️ Удалить" 
                                    Height="40"
                                    Width="130"
                                    Background="#f44336"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="btnDelete_Click"/>
                        </StackPanel>

                        <!-- Поиск -->
                        <Border Grid.Column="1" 
                                Background="White" 
                                CornerRadius="5"
                                BorderBrush="#DDD"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtSearch" 
                                         Height="40" 
                                         Padding="10,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         TextChanged="txtSearch_TextChanged"/>

                                <Button Grid.Column="1" 
                                        Content="🔍" 
                                        Width="40"
                                        Height="40"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="18"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="2" 
                          x:Name="dgProducts"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="White"
                          BorderBrush="#DDD"
                          BorderThickness="1"
                          RowHeight="45"
                          FontSize="14"
                          Margin="0,0,0,20"
                          MouseDoubleClick="dgProducts_MouseDoubleClick">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" 
                                            Binding="{Binding Id}" 
                                            Width="70"/>

                        <DataGridTextColumn Header="Наименование" 
                                            Binding="{Binding Name}" 
                                            Width="*"/>

                        <DataGridTextColumn Header="Категория" 
                                            Binding="{Binding Category}" 
                                            Width="150"/>

                        <DataGridTextColumn Header="Цена" 
                                            Binding="{Binding Price, StringFormat={}{0:C}}" 
                                            Width="120"/>

                        <DataGridTextColumn Header="Количество" 
                                            Binding="{Binding Quantity}" 
                                            Width="100"/>

                        <DataGridTextColumn Header="Статус" 
                                            Binding="{Binding Status}" 
                                            Width="120"/>

                        <DataGridTextColumn Header="Дата добавления" 
                                            Binding="{Binding AddedDate, StringFormat={}{0:dd.MM.yyyy}}" 
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Нижняя панель -->
                <Border Grid.Row="3" 
                        Background="#F5F5F5" 
                        CornerRadius="5" 
                        Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Информация о количестве -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Всего товаров: " 
                                       Foreground="#666"
                                       FontSize="14"/>
                            <TextBlock x:Name="txtTotalItems" 
                                       Text="0" 
                                       Foreground="#1E3C72"
                                       FontWeight="Bold"
                                       FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>